{
  "combination_mode": "product",
  "max_runs": 64,
  "base_config": {
    "backend.use_tfidf": true,
    "backend.use_st": false,
    "backend.lexical_mode": "tfidf",
    "chunking.strategy": "sliding_window",
    "chunking.chunk_size": 420,
    "chunking.chunk_overlap": 120,
    "selection.mode": "top_k",
    "selection.top_k": 3
  },
  "parameters": {
    "backend.lexical_mode": ["tfidf", "bm25"],
    "backend.use_regex_search": [false, true],
    "hyde.use_hyde": [false, true],
    "literal.use_llm_terms": [false, true],
    "rerank.enabled": [false, true],
    "selection.top_k": [3, 5]
  }
}
