{
  "combination_mode": "product",
  "max_runs": 48,
  "base_config": {
    "backend.use_tfidf": true,
    "backend.use_st": false,
    "chunking.strategy": "sliding_window",
    "chunking.chunk_size": 450,
    "chunking.chunk_overlap": 100,
    "selection.mode": "top_k_threshold",
    "selection.top_k": 4
  },
  "parameters": {
    "backend.lexical_mode": [
      "tfidf",
      "bm25"
    ],
    "selection.score_threshold": [
      0.05,
      0.1,
      0.15,
      0.2
    ],
    "backend.use_regex_search": [
      true,
      false
    ],
    "backend.bm25_k1": [
      1.2,
      1.5
    ],
    "backend.bm25_b": [
      0.6,
      0.75
    ]
  }
}
